// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output        = "../src/generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model UserData {
  id              Int               @id @default(autoincrement())
  did             String            @unique // Privy DID (required, unique)
  email           String? // nullable until user provides it
  isMinted        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  MintReceiptJson MintReceiptJson[]
}

model MintReceiptJson {
  id String @id @default(cuid())

  // relation to user
  user   UserData @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  // lightweight metadata
  txHash String @unique

  // entire viem TransactionReceipt (bigints stringified)
  raw Json

  createdAt DateTime @default(now())

  // indexes
  @@index([userId])
  @@index([txHash])
}
